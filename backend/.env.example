NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/MetaWealth
JWT_ACCESS_SECRET=<64 hex chars>
JWT_REFRESH_SECRET=<64 hex chars>
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
SEED_DEMO_PASSWORD=<dev only>
# 32-byte key for encrypting PAN/Aadhaar/passport at rest:  openssl rand -hex 32  (required in production; losing it makes those values unreadable)
DATA_ENCRYPTION_KEY=<64 hex chars>
# Optional: real email delivery (also run: npm i nodemailer -w @mwc/api). Without it, emails are written to the server log.
SMTP_URL=
MAIL_FROM=MetaWealth Capital <no-reply@yourdomain>
